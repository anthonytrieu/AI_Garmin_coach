# Example only. Export variables yourself; the app does not auto-load dotenv.
# Local-only development (binds to loopback; never expose publicly):
GARMIN_COACH_ENV=local
GARMIN_COACH_DATA=.local/data
GARMINTOKENS=.local/garmin
GARMIN_COACH_PROFILE=.local/athlete.md
GARMIN_COACH_PLAN_DIR=.local/training
# Hosted settings: use production, a random 24+ character password and exact HTTPS origin.
# COACH_PASSWORD=
# COACH_ORIGIN=https://your-personal-project.vercel.app
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# WEATHER_LATITUDE=
# WEATHER_LONGITUDE=
WEATHER_TIMEZONE=UTC
WEATHER_LOCATION=Configured forecast location
